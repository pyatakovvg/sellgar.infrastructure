{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "workload": {
      "enum": [
        "application",
        "migration"
      ]
    },
    "releaseId": {
      "type": "string",
      "pattern": "^[a-z0-9-]*$",
      "maxLength": 32
    },
    "environmentFile": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "data": {
          "type": "string"
        },
        "filename": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.-]+$"
        },
        "mountPath": {
          "type": "string",
          "pattern": "^/"
        }
      },
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        },
        "required": [
          "enabled"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "minLength": 1
          }
        },
        "required": [
          "data"
        ]
      }
    }
  }
}
