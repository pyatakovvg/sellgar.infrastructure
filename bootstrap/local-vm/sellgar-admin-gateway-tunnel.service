[Unit]
Description=Sellgar dev Admin gateway localhost tunnel
PartOf=sellgar-dev-tunnels.target
StartLimitIntervalSec=0

[Service]
Type=exec
ExecStart=%h/.local/share/sellgar/vm/sellgar-k3s/bin/kubectl --kubeconfig %h/.local/share/sellgar/vm/sellgar-k3s/kubeconfig -n sellgar-dev port-forward --address 127.0.0.1 --pod-running-timeout=30s service/admin-gateway 4020:8080
Restart=always
RestartSec=5
TimeoutStopSec=10
NoNewPrivileges=true
UMask=0077
